# BDK SPEAKER pure_sink - original ESP32, 4 MB flash, no PSRAM.
CONFIG_IDF_TARGET="esp32"

# Bluetooth: controller only (VHCI); the host is native_bt. The host's
# controller bring-up requires the dual-mode controller; nothing LE is used.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
# CONFIG_BTDM_CTRL_MODEM_SLEEP is not set
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Core 1: controller + host owner + I2S writer. Core 0: codec decoder.
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU1=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Size-optimized system code; the codec components force -O2 themselves.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Keep IRAM small: task-only FreeRTOS code in flash, ISR APIs stay in IRAM.
CONFIG_FREERTOS_IN_IRAM=n
# CONFIG_FREERTOS_PLACE_ISR_FUNCTIONS_INTO_FLASH is not set
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# I2S DMA ISR keeps running during NVS (flash) writes, e.g. when a bond is stored.
CONFIG_I2S_ISR_IRAM_SAFE=y

# Flash / partitions (bootloader 0x1000, table 0x8000, factory app 0x10000).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Console on UART0 (GPIO1/3) at the same 921600 baud as the existing firmware.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=1
CONFIG_ESP_CONSOLE_UART_RX_GPIO=3
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
